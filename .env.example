# Ontario Economic & Business Intelligence Platform
# Production & Deployment Environment Configuration

# Application Port (default: 3001)
PORT=3001

# Production PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ontario_economic_intelligence

# Environment Mode (production / development)
NODE_ENV=production

# Optional: Cloud deployment SSL enforcement
# DATABASE_SSL=true
