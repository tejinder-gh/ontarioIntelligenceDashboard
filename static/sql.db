CREATE EXTENSION IF NOT EXISTS pgcrypto;

-- ============================================================
-- ENUMS
-- ============================================================

CREATE TYPE firm_type AS ENUM (
    'venture_capital',
    'corporate_venture',
    'family_office',
    'angel_network',
    'accelerator',
    'incubator',
    'growth_equity',
    'private_equity',
    'government_fund',
    'university_fund',
    'other'
);

CREATE TYPE entity_status AS ENUM (
    'active',
    'inactive',
    'acquired',
    'closed',
    'unknown'
);

CREATE TYPE investment_stage AS ENUM (
    'idea',
    'pre_seed',
    'seed',
    'series_a',
    'series_b',
    'series_c',
    'series_d_plus',
    'growth',
    'pre_ipo',
    'public'
);

CREATE TYPE investment_role AS ENUM (
    'lead',
    'co_lead',
    'participant',
    'unknown'
);

CREATE TYPE investment_status AS ENUM (
    'active',
    'exited',
    'written_off',
    'unknown'
);

CREATE TYPE source_confidence AS ENUM (
    'verified',
    'high',
    'medium',
    'low',
    'unknown'
);

-- ============================================================
-- LOCATIONS
-- ============================================================

CREATE TABLE locations (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    country_code VARCHAR(3),
    country VARCHAR(120),
    region VARCHAR(120),
    state_province VARCHAR(120),
    city VARCHAR(120),

    latitude NUMERIC(9,6),
    longitude NUMERIC(9,6),

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ============================================================
-- VC FIRMS
-- ============================================================

CREATE TABLE vc_firms (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    name VARCHAR(255) NOT NULL,
    legal_name VARCHAR(255),

    website TEXT,
    linkedin_url TEXT,
    contact_email VARCHAR(320),
    office_address TEXT,

    description TEXT,

    firm_type firm_type NOT NULL DEFAULT 'venture_capital',
    status entity_status NOT NULL DEFAULT 'active',

    founded_year INTEGER,

    headquarters_location_id UUID
        REFERENCES locations(id)
        ON DELETE SET NULL,

    employee_count INTEGER,

    aum_amount NUMERIC(20,2),
    aum_currency CHAR(3),

    total_funds_raised_amount NUMERIC(20,2),
    total_funds_raised_currency CHAR(3),

    estimated_dry_powder_amount NUMERIC(20,2),
    estimated_dry_powder_currency CHAR(3),

    typical_check_min NUMERIC(20,2),
    typical_check_max NUMERIC(20,2),
    typical_check_currency CHAR(3),

    ownership_target_min NUMERIC(5,2),
    ownership_target_max NUMERIC(5,2),

    reserves_for_follow_on BOOLEAN,

    board_seat_preference BOOLEAN,

    portfolio_company_count INTEGER,
    active_portfolio_count INTEGER,
    exited_portfolio_count INTEGER,

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

    UNIQUE(name)
);

CREATE TABLE vc_firm_aliases (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    firm_id UUID NOT NULL
        REFERENCES vc_firms(id)
        ON DELETE CASCADE,

    alias VARCHAR(255) NOT NULL,

    UNIQUE(firm_id, alias)
);

CREATE TABLE vc_firm_offices (
    firm_id UUID NOT NULL
        REFERENCES vc_firms(id)
        ON DELETE CASCADE,

    location_id UUID NOT NULL
        REFERENCES locations(id)
        ON DELETE CASCADE,

    is_headquarters BOOLEAN NOT NULL DEFAULT FALSE,

    PRIMARY KEY (firm_id, location_id)
);

-- ============================================================
-- FUNDS
-- ============================================================

CREATE TABLE funds (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    firm_id UUID NOT NULL
        REFERENCES vc_firms(id)
        ON DELETE CASCADE,

    name VARCHAR(255) NOT NULL,

    fund_number INTEGER,
    vintage_year INTEGER,

    status VARCHAR(30) NOT NULL DEFAULT 'unknown'
        CHECK (
            status IN (
                'fundraising',
                'investing',
                'harvesting',
                'closed',
                'unknown'
            )
        ),

    target_size_amount NUMERIC(20,2),
    final_close_size_amount NUMERIC(20,2),
    currency CHAR(3),

    first_close_date DATE,
    final_close_date DATE,

    committed_capital NUMERIC(20,2),
    deployed_capital NUMERIC(20,2),
    remaining_capital NUMERIC(20,2),

    management_fee_percent NUMERIC(5,2),
    carried_interest_percent NUMERIC(5,2),

    fund_life_years INTEGER,

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

    UNIQUE(firm_id, name)
);

-- ============================================================
-- PEOPLE
-- ============================================================

CREATE TABLE people (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    first_name VARCHAR(120),
    last_name VARCHAR(120),

    full_name VARCHAR(255) NOT NULL,

    linkedin_url TEXT,
    x_url TEXT,
    personal_website TEXT,

    title VARCHAR(255),

    seniority VARCHAR(50),

    founder_background BOOLEAN,
    operator_background BOOLEAN,

    public_email VARCHAR(320),

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE person_firm_roles (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    person_id UUID NOT NULL
        REFERENCES people(id)
        ON DELETE CASCADE,

    firm_id UUID NOT NULL
        REFERENCES vc_firms(id)
        ON DELETE CASCADE,

    title VARCHAR(255),

    role_type VARCHAR(50),

    start_date DATE,
    end_date DATE,

    current BOOLEAN NOT NULL DEFAULT TRUE,

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ============================================================
-- SECTORS
-- ============================================================

CREATE TABLE sectors (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    name VARCHAR(255) NOT NULL,

    parent_sector_id UUID
        REFERENCES sectors(id)
        ON DELETE SET NULL,

    level INTEGER NOT NULL DEFAULT 0,

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

    UNIQUE(name, parent_sector_id)
);

CREATE TABLE sector_aliases (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    sector_id UUID NOT NULL
        REFERENCES sectors(id)
        ON DELETE CASCADE,

    alias VARCHAR(255) NOT NULL,

    UNIQUE(sector_id, alias)
);

CREATE TABLE firm_sector_focus (
    firm_id UUID NOT NULL
        REFERENCES vc_firms(id)
        ON DELETE CASCADE,

    sector_id UUID NOT NULL
        REFERENCES sectors(id)
        ON DELETE CASCADE,

    preference VARCHAR(30)
        CHECK (
            preference IN (
                'core',
                'active',
                'opportunistic'
            )
        ),

    investment_count INTEGER,

    PRIMARY KEY (firm_id, sector_id)
);

-- ============================================================
-- INVESTMENT STAGE FOCUS
-- ============================================================

CREATE TABLE firm_stage_focus (
    firm_id UUID NOT NULL
        REFERENCES vc_firms(id)
        ON DELETE CASCADE,

    stage investment_stage NOT NULL,

    preference VARCHAR(30),

    PRIMARY KEY (firm_id, stage)
);

-- ============================================================
-- GEOGRAPHY FOCUS
-- ============================================================

CREATE TABLE firm_geography_focus (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    firm_id UUID NOT NULL
        REFERENCES vc_firms(id)
        ON DELETE CASCADE,

    country_code VARCHAR(3),
    region VARCHAR(120),
    state_province VARCHAR(120),
    city VARCHAR(120),

    preference VARCHAR(30) NOT NULL
        CHECK (
            preference IN (
                'primary',
                'secondary',
                'opportunistic'
            )
        )
);

-- ============================================================
-- INVESTMENT THESIS
-- ============================================================

CREATE TABLE investment_theses (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    firm_id UUID NOT NULL
        REFERENCES vc_firms(id)
        ON DELETE CASCADE,

    summary TEXT,

    minimum_revenue NUMERIC(20,2),
    maximum_revenue NUMERIC(20,2),

    minimum_arr NUMERIC(20,2),
    maximum_arr NUMERIC(20,2),

    currency CHAR(3),

    preferred_growth_min NUMERIC(8,2),
    preferred_growth_max NUMERIC(8,2),

    preferred_check_min NUMERIC(20,2),
    preferred_check_max NUMERIC(20,2),

    preferred_check_currency CHAR(3),

    required_traction JSONB NOT NULL DEFAULT '[]',
    evaluation_criteria JSONB NOT NULL DEFAULT '[]',
    avoids JSONB NOT NULL DEFAULT '[]',
    themes JSONB NOT NULL DEFAULT '[]',
    business_models JSONB NOT NULL DEFAULT '[]',

    thesis_source_url TEXT,
    thesis_last_updated DATE,

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ============================================================
-- COMPANIES
-- ============================================================

CREATE TABLE companies (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    name VARCHAR(255) NOT NULL,
    legal_name VARCHAR(255),

    website TEXT,
    linkedin_url TEXT,

    description TEXT,

    founded_year INTEGER,

    status VARCHAR(30) NOT NULL DEFAULT 'unknown'
        CHECK (
            status IN (
                'private',
                'public',
                'acquired',
                'closed',
                'unknown'
            )
        ),

    headquarters_location_id UUID
        REFERENCES locations(id)
        ON DELETE SET NULL,

    employee_count INTEGER,

    estimated_revenue_amount NUMERIC(20,2),
    estimated_revenue_currency CHAR(3),

    estimated_arr_amount NUMERIC(20,2),
    estimated_arr_currency CHAR(3),

    total_funding_raised_amount NUMERIC(20,2),
    total_funding_currency CHAR(3),

    latest_valuation_amount NUMERIC(20,2),
    latest_valuation_currency CHAR(3),

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

    UNIQUE(name, website)
);

CREATE TABLE company_sectors (
    company_id UUID NOT NULL
        REFERENCES companies(id)
        ON DELETE CASCADE,

    sector_id UUID NOT NULL
        REFERENCES sectors(id)
        ON DELETE CASCADE,

    PRIMARY KEY(company_id, sector_id)
);

-- ============================================================
-- FOUNDERS
-- ============================================================

CREATE TABLE company_founders (
    company_id UUID NOT NULL
        REFERENCES companies(id)
        ON DELETE CASCADE,

    person_id UUID NOT NULL
        REFERENCES people(id)
        ON DELETE CASCADE,

    founder_title VARCHAR(255),

    PRIMARY KEY(company_id, person_id)
);

-- ============================================================
-- FUNDING ROUNDS
-- ============================================================

CREATE TABLE funding_rounds (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    company_id UUID NOT NULL
        REFERENCES companies(id)
        ON DELETE CASCADE,

    stage investment_stage,

    round_type VARCHAR(50),

    announced_date DATE,
    closed_date DATE,

    amount_raised NUMERIC(20,2),
    currency CHAR(3),

    pre_money_valuation NUMERIC(20,2),
    post_money_valuation NUMERIC(20,2),

    total_investor_count INTEGER,

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ============================================================
-- INVESTMENTS
-- ============================================================

CREATE TABLE investments (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    firm_id UUID NOT NULL
        REFERENCES vc_firms(id)
        ON DELETE CASCADE,

    fund_id UUID
        REFERENCES funds(id)
        ON DELETE SET NULL,

    company_id UUID NOT NULL
        REFERENCES companies(id)
        ON DELETE CASCADE,

    funding_round_id UUID
        REFERENCES funding_rounds(id)
        ON DELETE SET NULL,

    investment_date DATE,

    invested_amount NUMERIC(20,2),
    invested_currency CHAR(3),

    ownership_percent NUMERIC(8,4),

    shares_acquired NUMERIC(20,4),

    security_type VARCHAR(50),

    investment_role investment_role NOT NULL DEFAULT 'unknown',

    first_investment BOOLEAN NOT NULL DEFAULT FALSE,
    follow_on BOOLEAN NOT NULL DEFAULT FALSE,

    board_seat_obtained BOOLEAN,

    status investment_status NOT NULL DEFAULT 'unknown',

    estimated_current_value NUMERIC(20,2),
    estimated_current_value_currency CHAR(3),

    estimated_return_multiple NUMERIC(12,4),

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE investment_partners (
    investment_id UUID NOT NULL
        REFERENCES investments(id)
        ON DELETE CASCADE,

    person_id UUID NOT NULL
        REFERENCES people(id)
        ON DELETE CASCADE,

    PRIMARY KEY(investment_id, person_id)
);

-- ============================================================
-- EXITS
-- ============================================================

CREATE TABLE exits (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    company_id UUID NOT NULL
        REFERENCES companies(id)
        ON DELETE CASCADE,

    exit_type VARCHAR(30) NOT NULL,

    announced_date DATE,
    completion_date DATE,

    acquirer_company_id UUID
        REFERENCES companies(id)
        ON DELETE SET NULL,

    acquirer_name VARCHAR(255),

    transaction_value NUMERIC(20,2),
    currency CHAR(3),

    ticker VARCHAR(30),
    exchange VARCHAR(100),

    ipo_price NUMERIC(20,4),
    market_cap_at_ipo NUMERIC(20,2),

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ============================================================
-- LIMITED PARTNERS
-- ============================================================

CREATE TABLE limited_partners (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    name VARCHAR(255) NOT NULL,

    lp_type VARCHAR(50),

    country VARCHAR(120),

    aum_amount NUMERIC(20,2),
    aum_currency CHAR(3),

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

    UNIQUE(name)
);

CREATE TABLE fund_commitments (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    limited_partner_id UUID NOT NULL
        REFERENCES limited_partners(id)
        ON DELETE CASCADE,

    fund_id UUID NOT NULL
        REFERENCES funds(id)
        ON DELETE CASCADE,

    commitment_amount NUMERIC(20,2),
    currency CHAR(3),

    commitment_date DATE,

    UNIQUE(limited_partner_id, fund_id)
);

-- ============================================================
-- FUND PERFORMANCE
-- ============================================================

CREATE TABLE fund_performance (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    fund_id UUID NOT NULL
        REFERENCES funds(id)
        ON DELETE CASCADE,

    as_of_date DATE NOT NULL,

    tvpi NUMERIC(12,4),
    dpi NUMERIC(12,4),
    rvpi NUMERIC(12,4),

    gross_irr NUMERIC(8,4),
    net_irr NUMERIC(8,4),

    moic NUMERIC(12,4),

    invested_capital NUMERIC(20,2),
    realized_value NUMERIC(20,2),
    unrealized_value NUMERIC(20,2),

    currency CHAR(3),

    performance_quartile SMALLINT
        CHECK (performance_quartile BETWEEN 1 AND 4),

    benchmark_name VARCHAR(255),

    data_quality VARCHAR(30),

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

    UNIQUE(fund_id, as_of_date)
);

-- ============================================================
-- FUNDRAISING EVENTS
-- ============================================================

CREATE TABLE fundraising_events (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    firm_id UUID NOT NULL
        REFERENCES vc_firms(id)
        ON DELETE CASCADE,

    fund_id UUID
        REFERENCES funds(id)
        ON DELETE SET NULL,

    event_type VARCHAR(50) NOT NULL,

    event_date DATE,

    target_amount NUMERIC(20,2),
    amount_raised NUMERIC(20,2),

    currency CHAR(3),

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ============================================================
-- RELATIONSHIPS
-- ============================================================

CREATE TABLE investor_relationships (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    from_entity_id UUID NOT NULL,
    from_entity_type VARCHAR(30) NOT NULL,

    to_entity_id UUID NOT NULL,
    to_entity_type VARCHAR(30) NOT NULL,

    relationship_type VARCHAR(50) NOT NULL,

    strength NUMERIC(5,4)
        CHECK (
            strength IS NULL
            OR strength BETWEEN 0 AND 1
        ),

    first_observed DATE,
    last_observed DATE,

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

    CHECK (from_entity_id <> to_entity_id)
);

-- ============================================================
-- ACTIVITY SIGNALS
-- ============================================================

CREATE TABLE investor_signals (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    firm_id UUID
        REFERENCES vc_firms(id)
        ON DELETE CASCADE,

    person_id UUID
        REFERENCES people(id)
        ON DELETE CASCADE,

    signal_type VARCHAR(50) NOT NULL,

    observed_at TIMESTAMPTZ NOT NULL,

    description TEXT NOT NULL,

    signal_strength NUMERIC(5,4)
        CHECK (
            signal_strength IS NULL
            OR signal_strength BETWEEN 0 AND 1
        ),

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

    CHECK (
        firm_id IS NOT NULL
        OR person_id IS NOT NULL
    )
);

-- ============================================================
-- COMPANY METRICS
-- ============================================================

CREATE TABLE company_metrics (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    company_id UUID NOT NULL
        REFERENCES companies(id)
        ON DELETE CASCADE,

    metric_name VARCHAR(120) NOT NULL,

    numeric_value NUMERIC(30,8),

    text_value TEXT,

    unit VARCHAR(50),

    observed_at DATE,

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ============================================================
-- DERIVED INVESTOR ANALYTICS
-- ============================================================

CREATE TABLE investor_analytics (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    firm_id UUID NOT NULL
        REFERENCES vc_firms(id)
        ON DELETE CASCADE,

    calculated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

    total_investments INTEGER,

    new_investments_12m INTEGER,
    follow_on_investments_12m INTEGER,

    median_initial_check NUMERIC(20,2),
    average_initial_check NUMERIC(20,2),

    currency CHAR(3),

    median_round_size NUMERIC(20,2),

    lead_rate NUMERIC(8,4),
    follow_on_rate NUMERIC(8,4),

    exit_rate NUMERIC(8,4),
    unicorn_rate NUMERIC(8,4),
    write_off_rate NUMERIC(8,4),

    median_days_between_investments INTEGER,

    sector_distribution JSONB,
    stage_distribution JSONB,
    geography_distribution JSONB,
    co_investors JSONB
);

-- ============================================================
-- INVESTOR FIT SCORES
-- ============================================================

CREATE TABLE investor_fit_scores (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    company_id UUID NOT NULL
        REFERENCES companies(id)
        ON DELETE CASCADE,

    firm_id UUID NOT NULL
        REFERENCES vc_firms(id)
        ON DELETE CASCADE,

    calculated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

    overall_score NUMERIC(5,2)
        CHECK (
            overall_score >= 0
            AND overall_score <= 100
        ),

    stage_fit NUMERIC(5,2),
    sector_fit NUMERIC(5,2),
    geography_fit NUMERIC(5,2),
    check_size_fit NUMERIC(5,2),
    traction_fit NUMERIC(5,2),
    business_model_fit NUMERIC(5,2),
    portfolio_conflict NUMERIC(5,2),
    activity_score NUMERIC(5,2),
    relationship_score NUMERIC(5,2),

    reasons JSONB NOT NULL DEFAULT '[]',
    blockers JSONB NOT NULL DEFAULT '[]'
);

-- ============================================================
-- DATA SOURCES / PROVENANCE
-- ============================================================

CREATE TABLE sources (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    source_type VARCHAR(50) NOT NULL,

    url TEXT,

    publisher VARCHAR(255),
    title TEXT,

    published_at TIMESTAMPTZ,
    accessed_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

    confidence source_confidence NOT NULL DEFAULT 'unknown',

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE entity_sources (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    entity_type VARCHAR(100) NOT NULL,
    entity_id UUID NOT NULL,

    source_id UUID NOT NULL
        REFERENCES sources(id)
        ON DELETE CASCADE,

    field_name VARCHAR(255),

    extracted_value TEXT,

    confidence NUMERIC(5,4)
        CHECK (
            confidence IS NULL
            OR confidence BETWEEN 0 AND 1
        ),

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ============================================================
-- INDEXES
-- ============================================================

CREATE INDEX idx_vc_firms_name
    ON vc_firms(name);

CREATE INDEX idx_funds_firm
    ON funds(firm_id);

CREATE INDEX idx_people_full_name
    ON people(full_name);

CREATE INDEX idx_person_roles_firm
    ON person_firm_roles(firm_id);

CREATE INDEX idx_person_roles_person
    ON person_firm_roles(person_id);

CREATE INDEX idx_companies_name
    ON companies(name);

CREATE INDEX idx_company_sector_sector
    ON company_sectors(sector_id);

CREATE INDEX idx_rounds_company
    ON funding_rounds(company_id);

CREATE INDEX idx_rounds_date
    ON funding_rounds(announced_date DESC);

CREATE INDEX idx_investments_firm
    ON investments(firm_id);

CREATE INDEX idx_investments_company
    ON investments(company_id);

CREATE INDEX idx_investments_round
    ON investments(funding_round_id);

CREATE INDEX idx_investments_date
    ON investments(investment_date DESC);

CREATE INDEX idx_investor_signals_firm_date
    ON investor_signals(firm_id, observed_at DESC);

CREATE INDEX idx_company_metrics_company
    ON company_metrics(company_id);

CREATE INDEX idx_fit_company_score
    ON investor_fit_scores(company_id, overall_score DESC);

CREATE INDEX idx_fit_firm_score
    ON investor_fit_scores(firm_id, overall_score DESC);

CREATE INDEX idx_entity_sources_entity
    ON entity_sources(entity_type, entity_id);

-- JSONB indexes

CREATE INDEX idx_thesis_themes_gin
    ON investment_theses USING GIN(themes);

CREATE INDEX idx_thesis_models_gin
    ON investment_theses USING GIN(business_models);
